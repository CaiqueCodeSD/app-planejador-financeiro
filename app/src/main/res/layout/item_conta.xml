<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="46dp"
        android:layout_height="50dp"
        android:background="@color/pf_surface"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDiaConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMesConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescricaoItemConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVencimentoItemConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSituacaoItemConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMarcarComoPaga"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pf_lime"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:text="Marcar como paga"
            android:textAllCaps="false"
            android:textColor="@color/pf_background"
            android:textSize="11sp" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditarConta"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/pf_blue_light"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="@color/pf_background"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnExcluirConta"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pf_bg_delete_button"
                android:contentDescription="Excluir conta"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/ic_delete"
                android:tint="@color/white" />

        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/tvValorItemConta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/pf_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
