<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/pf_bg_glass_card"
    android:padding="16dp">

    <!-- Informações da movimentação -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescricaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da movimentação"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCategoriaHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Categoria"
            android:textColor="@color/pf_text_secondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDataHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="29/10/2026"
            android:textColor="@color/pf_text_secondary"
            android:textSize="11sp" />

        <!-- Botão de edição -->
        <Button
            android:id="@+id/btnEditarMovimentacao"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/pf_blue_light"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:text="Editar"
            android:textAllCaps="false"
            android:textColor="@color/pf_background"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Valor da movimentação -->
    <TextView
        android:id="@+id/tvValorHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:text="R$ 250,00"
        android:textColor="@color/pf_green"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- Botão de exclusão -->
    <ImageButton
        android:id="@+id/btnExcluirMovimentacao"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/pf_bg_delete_button"
        android:src="@drawable/ic_delete"
        android:scaleType="center"
        android:padding="10dp"
        android:tint="@color/white"
        android:contentDescription="Excluir movimentação"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
