            <TextView
                android:id="@+id/navBillsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contas"
                android:textColor="@color/pf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

