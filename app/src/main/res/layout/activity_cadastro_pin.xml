<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pf_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLANEJADOR FINANCEIRO"
                android:textColor="@color/pf_lime"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:gravity="center"
                android:text="Proteja seu\naplicativo."
                android:textColor="@color/pf_text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Crie um PIN para adicionar uma camada de proteção às suas informações financeiras."
                android:textColor="@color/pf_text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="@drawable/pf_bg_glass_card"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CRIE SEU PIN"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Campo do novo PIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pf_bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNovoPin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:hint="••••"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textColor="@color/pf_text_primary"
                        android:textColorHint="@color/pf_text_secondary"
                        android:textSize="24sp"
                        android:importantForAutofill="no"
                        android:contentDescription="Novo PIN de quatro dígitos" />

                    <ImageButton
                        android:id="@+id/btnMostrarNovoPin"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Mostrar PIN"
                        android:padding="12dp"
                        app:tint="@color/pf_text_secondary" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="CONFIRME SEU PIN"
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Campo de confirmação do PIN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pf_bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etConfirmacaoPin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:hint="••••"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:textColor="@color/pf_text_primary"
                        android:textColorHint="@color/pf_text_secondary"
                        android:textSize="24sp"
                        android:importantForAutofill="no"
                        android:contentDescription="Confirmação do PIN" />

                    <ImageButton
                        android:id="@+id/btnMostrarConfirmacaoPin"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="Mostrar confirmação do PIN"
                        android:padding="12dp"
                        app:tint="@color/pf_text_secondary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvErroCadastroPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="#FF7777"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAtivarProtecao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Ativar proteção"
                    android:textAllCaps="false"
                    android:textColor="@color/pf_background"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pf_lime" />

                <Button
                    android:id="@+id/btnContinuarSemPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Agora não"
                    android:textAllCaps="false"
                    android:textColor="@color/pf_text_secondary"
                    style="?attr/materialButtonOutlinedStyle" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/pf_bg_glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ATENÇÃO"
                    android:textColor="@color/expense_terracotta"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="O PIN não poderá ser recuperado caso você o esqueça. Sem ele, não será possível desbloquear o aplicativo. Guarde-o em um local seguro."
                    android:textColor="@color/pf_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Sua privacidade é nossa prioridade."
                android:textColor="@color/pf_text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
